---
import ArticleCard from './ArticleCard.astro';
import { CATEGORIES, type CategoryKey } from '../lib/categories';
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentId: string;
  articles: CollectionEntry<'articles'>[];
  category: CategoryKey;
}

const { currentId, articles, category } = Astro.props;

const current = articles.find((article) => article.id === currentId);

function topicTokens(article: CollectionEntry<'articles'> | undefined): Set<string> {
  if (!article) return new Set();
  const text = [
    article.data.title,
    article.data.cardTitle,
    ...(article.data.keywords ?? []),
  ].join(' ').toLowerCase();
  return new Set(
    text
      .replace(/[^a-z0-9]+/g, ' ')
      .split(/\s+/)
      .filter((token) => token.length > 3 && !['amazon', 'best', 'guide', 'under', 'alternative'].includes(token)),
  );
}

const currentTokens = topicTokens(current);
const picks = articles
  .filter((article) => article.id !== currentId)
  .map((article) => {
    const overlap = [...topicTokens(article)].filter((token) => currentTokens.has(token)).length;
    const categoryScore = article.data.category === category ? 6 : 0;
    return { article, score: categoryScore + overlap };
  })
  .sort((a, b) =>
    b.score - a.score ||
    b.article.data.publishedAt.valueOf() - a.article.data.publishedAt.valueOf()
  )
  .slice(0, 6)
  .map(({ article }) => article);

if (picks.length === 0) return null;
---

<section class="mt-16 border-t border-gray-200 pt-12">
  <h2 class="text-2xl font-bold text-gray-900">Related guides and comparisons</h2>
  <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {
      picks.map((article) => (
        <ArticleCard
          title={article.data.cardTitle}
          excerpt={article.data.cardExcerpt}
          href={`/articles/${article.id}`}
          category={article.data.categoryLabel}
          categoryColor={CATEGORIES[article.data.category as CategoryKey]?.color ?? 'bg-gray-100 text-gray-700'}
          articleType={article.data.articleType}
        />
      ))
    }
  </div>
</section>
