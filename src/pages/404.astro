---
import BaseLayout from '../layouts/BaseLayout.astro';

// Cloudflare Pages serves this as 404.html for missing paths (disable SPA fallback in dashboard).
---

<BaseLayout
  title="Page Not Found | AltPik"
  description="That page is not on AltPik. Browse our Amazon guides and product comparisons."
  noindex={true}
>
  <div class="mx-auto max-w-xl px-4 py-24 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600">404</p>
    <h1 class="mt-3 text-3xl font-extrabold text-gray-900">Page not found</h1>
    <p class="mt-4 text-gray-600">
      This URL does not exist. Try our guides or search reviews on the site.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-xl bg-brand-600 px-5 py-2.5 text-sm font-bold text-white hover:bg-brand-700"
      >
        Home
      </a>
      <a
        href="/reviews?type=listicle"
        class="rounded-xl border border-gray-300 px-5 py-2.5 text-sm font-bold text-gray-700 hover:bg-gray-50"
      >
        Top 10 Guides
      </a>
    </div>
  </div>
</BaseLayout>
